{% extends "layout.twig" %}

{% block title %}{{ business.name }} - Local Business Directory{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Hero & Actions -->
        <div class="lg:col-span-4 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
                <img src="{{ business.hero_image ?: 'https://via.placeholder.com/800x600?text=No+Image' }}" alt="{{ business.name }}" class="w-full h-64 object-cover">
                <div class="p-6 space-y-4">
                    <div class="flex justify-between items-start">
                        <h1 class="text-2xl font-bold">{{ business.name }}</h1>
                        {% if session.user_id %}
                            <form action="/businesses/{{ business.id }}/favorite" method="POST">
                                <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                                <button type="submit" class="text-gray-400 hover:text-red-500 transition">
                                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% for cat in business_categories %}
                            <span class="text-[10px] bg-gray-100 text-gray-600 px-2 py-0.5 rounded font-bold uppercase">{{ cat }}</span>
                        {% endfor %}
                    </div>

                    <div class="grid grid-cols-1 gap-3 pt-4">
                        <a href="tel:{{ business.phone }}" class="flex items-center justify-center gap-2 bg-primary text-white py-3 rounded-lg font-bold hover:bg-red-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            Call Now
                        </a>
                        <a href="https://wa.me/{{ business.whatsapp|replace({'+': '', ' ': ''}) }}" target="_blank" class="flex items-center justify-center gap-2 bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700 transition">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.246 2.248 3.484 5.232 3.484 8.412-.003 6.557-5.338 11.892-11.893 11.892-1.996-.001-3.951-.5-5.688-1.448l-6.309 1.656zm6.29-4.464c1.56.925 3.125 1.419 4.767 1.42 5.235 0 9.497-4.262 9.498-9.498 0-2.541-.99-4.925-2.788-6.722-1.797-1.797-4.181-2.787-6.721-2.787-5.234 0-9.497 4.263-9.498 9.499 0 1.708.469 3.371 1.358 4.814l-1.021 3.731 3.824-1.002z"/></svg>
                            WhatsApp
                        </a>
                        <a href="https://www.google.com/maps/dir/?api=1&destination={{ business.latitude }},{{ business.longitude }}" target="_blank" class="flex items-center justify-center gap-2 bg-gray-800 text-white py-3 rounded-lg font-bold hover:bg-gray-900 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                            Get Directions
                        </a>
                    </div>
                </div>
            </div>

            {% if gallery %}
            <div class="bg-white p-6 rounded-xl shadow-sm border">
                <h3 class="font-bold text-gray-900 mb-4">Gallery</h3>
                <div class="grid grid-cols-2 gap-2">
                    {% for item in gallery %}
                        <img src="{{ item.image_path }}" class="w-full h-24 object-cover rounded shadow-sm hover:opacity-75 transition cursor-pointer">
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Middle Column: Map & About -->
        <div class="lg:col-span-5 space-y-6">
            <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
                <div id="business-map" style="height: 350px;"></div>
            </div>

            <div class="bg-white p-8 rounded-xl shadow-sm border">
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-2xl font-bold">About</h2>
                    {% if rating_stats.count > 0 %}
                        <div class="flex items-center gap-1 bg-yellow-50 px-3 py-1 rounded-full border border-yellow-200">
                            <span class="text-yellow-600 font-bold">{{ rating_stats.avg_rating|number_format(1) }}</span>
                            <svg class="w-4 h-4 text-yellow-500 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                            <span class="text-gray-400 text-xs">({{ rating_stats.count }})</span>
                        </div>
                    {% endif %}
                </div>
                <div class="prose max-w-none text-gray-700">
                    {{ business.description|nl2br }}
                </div>
            </div>

            <!-- Flagship Product Highlight -->
            {% set flagship = null %}
            {% for item in offerings %}{% if item.is_flagship %}{% set flagship = item %}{% endif %}{% endfor %}

            {% if flagship %}
                <div class="bg-gradient-to-r from-primary to-red-800 p-8 rounded-xl shadow-lg border text-white relative overflow-hidden">
                    <div class="absolute top-4 right-4 bg-yellow-400 text-red-900 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">Flagship Product</div>
                    <div class="flex gap-6 items-center">
                        {% if flagship.image_path %}
                            <img src="{{ flagship.image_path }}" class="w-32 h-32 object-cover rounded-lg border-2 border-white shadow-md">
                        {% endif %}
                        <div>
                            <h3 class="text-2xl font-black mb-1">{{ flagship.name }}</h3>
                            <p class="text-red-100 text-sm mb-4 leading-relaxed">{{ flagship.description }}</p>
                            <div class="text-3xl font-bold">₹{{ flagship.price }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Offerings -->
            {% if offerings %}
            <div class="bg-white p-8 rounded-xl shadow-sm border">
                <h2 class="text-xl font-bold mb-6">Products & Services</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for item in offerings %}
                        <div class="border rounded-lg p-4 flex gap-4 {% if item.is_flagship %}bg-yellow-50 border-yellow-200{% endif %}">
                            {% if item.image_path %}
                                <img src="{{ item.image_path }}" class="w-20 h-20 object-cover rounded shadow-sm">
                            {% endif %}
                            <div>
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-gray-900">{{ item.name }}</h4>
                                    {% if item.is_flagship %}<span class="text-[8px] bg-yellow-400 text-yellow-900 px-1.5 py-0.5 rounded font-bold uppercase">Flagship</span>{% endif %}
                                </div>
                                <p class="text-xs text-gray-500 line-clamp-2">{{ item.description }}</p>
                                <div class="mt-2 text-primary font-bold">₹{{ item.price }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Achievements -->
            {% if achievements %}
            <div class="bg-white p-8 rounded-xl shadow-sm border">
                <h2 class="text-xl font-bold mb-6">Achievements & Certifications</h2>
                <div class="space-y-4">
                    {% for item in achievements %}
                        <div class="flex gap-4 items-start p-4 bg-gray-50 rounded-lg border">
                            {% if item.image_path %}
                                <img src="{{ item.image_path }}" class="w-16 h-16 object-contain bg-white border rounded">
                            {% else %}
                                <div class="w-16 h-16 flex items-center justify-center bg-white border rounded text-gray-300">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                                </div>
                            {% endif %}
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded-full
                                        {% if item.type == 'award' %}bg-yellow-100 text-yellow-800
                                        {% elseif item.type == 'certification' %}bg-green-100 text-green-800
                                        {% else %}bg-blue-100 text-blue-800{% endif %}">
                                        {{ item.type }}
                                    </span>
                                    <span class="text-[10px] text-gray-400">{{ item.date_awarded|date("Y") }}</span>
                                </div>
                                <h4 class="font-bold text-gray-900">{{ item.title }}</h4>
                                <p class="text-xs text-primary font-medium">{{ item.issuer }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Reviews Section -->
            <div class="bg-white p-8 rounded-xl shadow-sm border">
                <h2 class="text-xl font-bold mb-6">Reviews & Ratings</h2>

                {% if session.user_id %}
                    <form action="/businesses/{{ business.id }}/review" method="POST" class="mb-8 p-4 bg-gray-50 rounded-lg border">
                        <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                        <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Your Rating</label>
                            <select name="rating" class="w-full p-2 border rounded" required>
                                <option value="5">5 Stars - Excellent</option>
                                <option value="4">4 Stars - Good</option>
                                <option value="3">3 Stars - Average</option>
                                <option value="2">2 Stars - Poor</option>
                                <option value="1">1 Star - Very Bad</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-bold mb-2">Comment</label>
                            <textarea name="comment" class="w-full p-2 border rounded h-24" placeholder="Tell us about your experience..."></textarea>
                        </div>
                        <button type="submit" class="bg-primary text-white px-6 py-2 rounded font-bold hover:bg-red-700">Submit Review</button>
                    </form>
                {% else %}
                    <div class="bg-blue-50 p-4 rounded text-sm text-blue-700 mb-8">
                        Please <a href="/login" class="font-bold underline">login</a> to leave a review.
                    </div>
                {% endif %}

                <div class="space-y-6">
                    {% for review in reviews %}
                        <div class="border-b last:border-0 pb-6">
                            <div class="flex justify-between items-start mb-2">
                                <div class="font-bold text-gray-900">{{ review.user_name ?: 'Guest' }}</div>
                                <div class="flex text-yellow-500">
                                    {% for i in 1..5 %}
                                        <svg class="w-4 h-4 {{ i <= review.rating ? 'fill-current' : 'text-gray-300 fill-current' }}" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                    {% endfor %}
                                </div>
                            </div>
                            <p class="text-gray-600 text-sm italic">"{{ review.comment }}"</p>
                            {% if review.reply %}
                                <div class="mt-3 ml-4 p-3 bg-gray-100 rounded border-l-4 border-primary">
                                    <div class="text-xs font-bold text-primary mb-1">Owner Response:</div>
                                    <p class="text-gray-700 text-sm">{{ review.reply }}</p>
                                </div>
                            {% endif %}
                            <div class="mt-2 text-xs text-gray-400">{{ review.created_at|date("M d, Y") }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if business.youtube_video_id %}
            <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/{{ business.youtube_video_id }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            {% endif %}
        </div>

        <!-- Right Column: Info, Enquiry & Hours -->
        <div class="lg:col-span-3 space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    Send Enquiry
                </h3>
                <form action="/businesses/{{ business.id }}/enquiry" method="POST" class="space-y-3">
                    <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                    <input type="text" name="name" placeholder="Your Name" class="w-full p-2 text-sm border rounded" required>
                    <input type="email" name="email" placeholder="Your Email" class="w-full p-2 text-sm border rounded" required>
                    <input type="tel" name="phone" placeholder="Phone Number" class="w-full p-2 text-sm border rounded">
                    <textarea name="message" placeholder="I'm interested in..." class="w-full p-2 text-sm border rounded h-20" required></textarea>
                    <button type="submit" class="w-full bg-primary text-white py-2 rounded font-bold hover:bg-red-700 transition">Send Message</button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-sm border">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Contact Address
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                    {{ business.address }}<br>
                    {{ business.district }}, {{ business.state }} - {{ business.pin }}
                </p>
                <div class="mt-4 pt-4 border-t space-y-2">
                    <div class="text-sm text-gray-600"><strong>Email:</strong> {{ business.email }}</div>
                    <div class="text-sm text-gray-600"><strong>Phone:</strong> {{ business.phone }}</div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-sm border">
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Working Hours
                </h3>
                <table class="w-full text-sm">
                    {% for hour in hours %}
                    <tr class="{% if not loop.last %}border-b{% endif %}">
                        <td class="py-2 font-medium text-gray-700">{{ hour.day_of_week }}</td>
                        <td class="py-2 text-right text-gray-600">
                            {% if hour.is_closed %}
                                <span class="text-red-500 font-semibold uppercase text-xs">Closed</span>
                            {% else %}
                                {{ hour.open_time|date("g:i a") }} - {{ hour.close_time|date("g:i a") }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var map = L.map('business-map').setView([{{ business.latitude }}, {{ business.longitude }}], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    L.marker([{{ business.latitude }}, {{ business.longitude }}])
        .addTo(map)
        .bindPopup("<b>{{ business.name }}</b><br>{{ business.address }}")
        .openPopup();
</script>
{% endblock %}
