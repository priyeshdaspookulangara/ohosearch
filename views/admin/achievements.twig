{% extends "layout.twig" %}

{% block title %}Manage Achievements - {{ business_id }}{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Achievements & Certifications</h1>
        <a href="/businesses/{{ business_id }}/edit" class="text-gray-600 hover:text-primary">&larr; Back to Edit Business</a>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm border mb-8">
        <h2 class="text-xl font-bold mb-4">Add Achievement / Award</h2>
        <form action="/businesses/{{ business_id }}/achievements" method="POST" enctype="multipart/form-data" class="space-y-4">
            <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
            <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold mb-2">Title</label>
                    <input type="text" name="title" class="w-full p-2 border rounded" required placeholder="e.g. Best Service Award 2023">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2">Type</label>
                    <select name="type" class="w-full p-2 border rounded">
                        <option value="achievement">Achievement</option>
                        <option value="award">Award</option>
                        <option value="certification">Government Certification</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold mb-2">Issuer</label>
                    <input type="text" name="issuer" class="w-full p-2 border rounded" placeholder="e.g. Ministry of Tourism">
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2">Date Awarded</label>
                    <input type="date" name="date_awarded" class="w-full p-2 border rounded">
                </div>
            </div>
            <div>
                <label class="block text-sm font-bold mb-2">Description</label>
                <textarea name="description" class="w-full p-2 border rounded h-20"></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold mb-2">Certificate/Award Image</label>
                <input type="file" name="image" class="w-full">
            </div>
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded font-bold hover:bg-red-700">Save Achievement</button>
        </form>
    </div>

    <div class="grid grid-cols-1 gap-4">
        {% for item in achievements %}
            <div class="bg-white p-6 rounded-lg shadow-sm border flex gap-6">
                {% if item.image_path %}
                    <img src="{{ item.image_path }}" class="w-32 h-32 object-contain bg-gray-50 border rounded p-1">
                {% else %}
                    <div class="w-32 h-32 bg-gray-100 rounded flex items-center justify-center text-gray-400">No Image</div>
                {% endif %}
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-full
                            {% if item.type == 'award' %}bg-yellow-100 text-yellow-800
                            {% elif item.type == 'certification' %}bg-green-100 text-green-800
                            {% else %}bg-blue-100 text-blue-800{% endif %}">
                            {{ item.type }}
                        </span>
                        {% if item.date_awarded %}
                            <span class="text-xs text-gray-400">{{ item.date_awarded|date("M Y") }}</span>
                        {% endif %}
                    </div>
                    <h4 class="font-bold text-xl text-gray-900">{{ item.title }}</h4>
                    <p class="text-sm text-primary font-medium mb-2">{{ item.issuer }}</p>
                    <p class="text-sm text-gray-600 italic">{{ item.description }}</p>
                </div>
            </div>
        {% else %}
            <div class="text-center py-12 bg-gray-50 border border-dashed rounded-lg text-gray-500">
                No achievements added yet.
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
