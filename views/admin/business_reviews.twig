{% extends "layout.twig" %}

{% block title %}Reviews for {{ business_name }} - Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8 flex items-center gap-4">
        <a href="/dashboard" class="text-primary hover:underline flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Dashboard
        </a>
    </div>

    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-3xl font-bold">Business Feedbacks</h1>
            <p class="text-gray-500 mt-1">Reviewing ratings and comments for <span class="font-bold text-gray-900">{{ business_name }}</span></p>
        </div>
        <a href="/businesses/{{ business_id }}" target="_blank" class="text-sm bg-gray-100 px-3 py-1 rounded hover:bg-gray-200">View Public Profile</a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100 text-gray-600 text-sm">
                    <th class="p-4">Customer</th>
                    <th class="p-4">Rating</th>
                    <th class="p-4">Feedback</th>
                    <th class="p-4">Date</th>
                </tr>
            </thead>
            <tbody>
                {% for review in reviews %}
                <tr class="border-t">
                    <td class="p-4">
                        <div class="font-bold text-gray-900">{{ review.user_name ?: 'Guest' }}</div>
                        <div class="text-xs text-gray-400">ID: #{{ review.user_id ?: 'N/A' }}</div>
                    </td>
                    <td class="p-4">
                        <div class="flex text-yellow-500">
                            {% for i in 1..5 %}
                                <svg class="w-4 h-4 {{ i <= review.rating ? 'fill-current' : 'text-gray-200 fill-current' }}" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                            {% endfor %}
                        </div>
                        <div class="text-[10px] font-bold text-gray-400 uppercase mt-1">{{ review.rating }} / 5 Stars</div>
                    </td>
                    <td class="p-4">
                        <p class="text-sm text-gray-700 italic">"{{ review.comment }}"</p>
                        {% if review.reply %}
                            <div class="mt-2 text-xs bg-blue-50 text-blue-700 p-2 rounded border border-blue-100">
                                <span class="font-bold">Owner Response:</span> {{ review.reply }}
                            </div>
                        {% endif %}
                    </td>
                    <td class="p-4 text-sm text-gray-500">
                        {{ review.created_at|date("M d, Y") }}
                        <div class="text-[10px]">{{ review.created_at|date("h:i A") }}</div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="p-12 text-center text-gray-400">
                        <svg class="w-12 h-12 mx-auto mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                        No reviews submitted yet for this business.
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
