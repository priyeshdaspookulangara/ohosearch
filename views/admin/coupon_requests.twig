{% extends "layout.twig" %}

{% block title %}Coupon Requests - Admin{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Coupon Requests</h1>
        <a href="/dashboard" class="text-gray-600 hover:text-primary">&larr; Back to Dashboard</a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100 text-gray-600 text-sm">
                    <th class="p-4">User</th>
                    <th class="p-4">Business</th>
                    <th class="p-4">Purpose</th>
                    <th class="p-4">Date</th>
                    <th class="p-4">Status</th>
                    <th class="p-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for req in requests %}
                <tr class="border-t">
                    <td class="p-4 font-bold text-gray-900">{{ req.user_name }}</td>
                    <td class="p-4 text-sm">{{ req.business_name ?: 'N/A' }}</td>
                    <td class="p-4 uppercase text-xs font-bold">{{ req.purpose }}</td>
                    <td class="p-4 text-sm text-gray-500">{{ req.created_at|date("M d, Y") }}</td>
                    <td class="p-4">
                        <span class="px-2 py-1 text-xs rounded-full font-bold uppercase
                            {% if req.status == 'approved' %}bg-green-100 text-green-800
                            {% elif req.status == 'rejected' %}bg-red-100 text-red-800
                            {% else %}bg-yellow-100 text-yellow-800{% endif %}">
                            {{ req.status }}
                        </span>
                    </td>
                    <td class="p-4 text-right">
                        {% if req.status == 'pending' %}
                            <form action="/admin/coupons/requests/{{ req.id }}/approve" method="POST" class="inline">
                                <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                                <button class="text-xs bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700">Approve & Generate Code</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="p-8 text-center text-gray-500">No coupon requests found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
