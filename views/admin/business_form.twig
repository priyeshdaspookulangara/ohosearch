{% extends "layout.twig" %}

{% block title %}{{ business ? 'Edit' : 'Add' }} Business - Local Business Directory{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">{{ business ? 'Edit' : 'Add New' }} Business Listing</h1>
        <a href="/dashboard" class="text-gray-600 hover:text-primary">&larr; Back to Dashboard</a>
    </div>

    {% if errors %}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
            <ul class="list-disc ml-5">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form action="{{ business ? '/businesses/' ~ business.id ~ '/edit' : '/businesses/create' }}" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
        <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border">
                <h2 class="text-xl font-bold mb-4">Basic Information</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Business Name</label>
                        <input type="text" name="name" value="{{ business.name ?: form_data.name }}" class="mt-1 block w-full border rounded-md shadow-sm p-2" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Description</label>
                        <textarea name="description" rows="4" class="mt-1 block w-full border rounded-md shadow-sm p-2">{{ business.description ?: form_data.description }}</textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Categories (Select one or more)</label>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 p-3 border rounded bg-gray-50 max-h-48 overflow-y-auto">
                            {% for category in categories %}
                                <label class="flex items-center gap-2 text-sm cursor-pointer hover:bg-gray-100 p-1 rounded">
                                    <input type="checkbox" name="category_ids[]" value="{{ category.id }}"
                                        {% if category.id in selected_categories or category.id in form_data.category_ids %}checked{% endif %}>
                                    {{ category.name }}
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">YouTube Video ID (Optional)</label>
                        <input type="text" name="youtube_video_id" value="{{ business.youtube_video_id ?: form_data.youtube_video_id }}" placeholder="e.g. dQw4w9WgXcQ" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border">
                <h2 class="text-xl font-bold mb-4">Location & Contact</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Full Address</label>
                        <input type="text" name="address" value="{{ business.address ?: form_data.address }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">District</label>
                            <input type="text" name="district" value="{{ business.district ?: form_data.district }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">State</label>
                            <input type="text" name="state" value="{{ business.state ?: form_data.state }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">PIN Code</label>
                            <input type="text" name="pin" value="{{ business.pin ?: form_data.pin }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Phone</label>
                            <input type="text" name="phone" value="{{ business.phone ?: form_data.phone }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Email</label>
                            <input type="email" name="email" value="{{ business.email ?: form_data.email }}" class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">WhatsApp Number</label>
                            <input type="text" name="whatsapp" value="{{ business.whatsapp ?: form_data.whatsapp }}" placeholder="+91..." class="mt-1 block w-full border rounded-md shadow-sm p-2">
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Pick Location on Map</label>
                        <div id="map-picker" style="height: 300px;" class="rounded border"></div>
                        <div class="grid grid-cols-2 gap-4 mt-2">
                            <input type="text" name="latitude" id="lat" value="{{ business.latitude ?: form_data.latitude }}" placeholder="Latitude" class="p-2 border rounded" readonly required>
                            <input type="text" name="longitude" id="lng" value="{{ business.longitude ?: form_data.longitude }}" placeholder="Longitude" class="p-2 border rounded" readonly required>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border">
                <h2 class="text-xl font-bold mb-4">Gallery Images</h2>
                <input type="file" name="gallery[]" multiple accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200">
                <p class="mt-2 text-xs text-gray-500">You can select multiple images for the gallery.</p>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border">
                <h2 class="text-xl font-bold mb-4">Hero Image</h2>
                {% if business.hero_image %}
                    <img src="{{ business.hero_image }}" class="w-full h-32 object-cover rounded mb-4">
                {% endif %}
                <input type="file" name="hero_image" accept="image/*" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-red-700">
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border">
                <h2 class="text-xl font-bold mb-4">Working Hours</h2>
                <div class="space-y-3">
                    {% set days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] %}
                    {% for day in days %}
                    <div class="flex items-center gap-2">
                        <span class="w-20 text-sm font-medium">{{ day }}</span>
                        <input type="time" name="hours[{{ day }}][open]" value="{{ hours[day].open_time ?: '09:00' }}" class="p-1 border rounded text-xs">
                        <span class="text-gray-400">-</span>
                        <input type="time" name="hours[{{ day }}][close]" value="{{ hours[day].close_time ?: '18:00' }}" class="p-1 border rounded text-xs">
                        <label class="flex items-center gap-1 ml-auto">
                            <input type="checkbox" name="hours[{{ day }}][is_closed]" class="rounded" {{ hours[day].is_closed ? 'checked' : '' }}>
                            <span class="text-xs">Closed</span>
                        </label>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <button type="submit" class="w-full bg-primary text-white py-4 rounded-lg font-bold text-lg shadow-lg hover:bg-red-700 transition">
                {{ business ? 'Update' : 'Save' }} Listing
            </button>

            {% if business %}
                <a href="/businesses/{{ business.id }}/achievements" class="block w-full text-center bg-gray-800 text-white py-2 rounded-lg font-bold mt-4 hover:bg-gray-900 transition">
                    Manage Achievements & Awards
                </a>
            {% endif %}
        </div>
    </form>
</div>

<script>
    var initialLat = {{ business.latitude ?: form_data.latitude ?: 20.5937 }};
    var initialLng = {{ business.longitude ?: form_data.longitude ?: 78.9629 }};
    var zoom = {{ business.latitude ? 15 : 5 }};

    var map = L.map('map-picker').setView([initialLat, initialLng], zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var marker;
    if ({{ business.latitude ? 'true' : 'false' }}) {
        marker = L.marker([initialLat, initialLng]).addTo(map);
    }

    map.on('click', function(e) {
        if (marker) {
            map.removeLayer(marker);
        }
        marker = L.marker(e.latlng).addTo(map);
        document.getElementById('lat').value = e.latlng.lat.toFixed(8);
        document.getElementById('lng').value = e.latlng.lng.toFixed(8);
    });

    {% if not business.latitude %}
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function(position) {
            map.setView([position.coords.latitude, position.coords.longitude], 13);
        });
    }
    {% endif %}
</script>
{% endblock %}
