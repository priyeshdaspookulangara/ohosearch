{% extends "layout.twig" %}

{% block title %}Enquiries - Local Business Directory{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Business Enquiries</h1>
        <a href="/dashboard" class="text-gray-600 hover:text-primary">&larr; Back to Dashboard</a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-100 text-gray-600 text-sm">
                    <th class="p-4">Customer</th>
                    <th class="p-4">Business</th>
                    <th class="p-4">Message</th>
                    <th class="p-4">Date</th>
                    <th class="p-4">Status</th>
                </tr>
            </thead>
            <tbody>
                {% for enquiry in enquiries %}
                <tr class="border-t">
                    <td class="p-4">
                        <div class="font-bold text-gray-900">{{ enquiry.customer_name }}</div>
                        <div class="text-xs text-gray-500">{{ enquiry.customer_email }}</div>
                        <div class="text-xs text-gray-500">{{ enquiry.customer_phone }}</div>
                    </td>
                    <td class="p-4">
                        <span class="text-sm font-semibold">{{ enquiry.business_name }}</span>
                    </td>
                    <td class="p-4">
                        <p class="text-sm text-gray-700 max-w-xs">{{ enquiry.message }}</p>
                    </td>
                    <td class="p-4 text-sm text-gray-500">
                        {{ enquiry.created_at|date("M d, Y H:i") }}
                    </td>
                    <td class="p-4">
                        <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full uppercase font-bold">
                            {{ enquiry.status }}
                        </span>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="p-8 text-center text-gray-500">No enquiries received yet.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
